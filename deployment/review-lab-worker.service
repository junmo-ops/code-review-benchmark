[Unit]
Description=Review Lab Benchmark Worker
After=network.target
[Service]
User=reviewlab
Group=reviewlab
WorkingDirectory=/opt/review-lab
EnvironmentFile=/etc/review-lab/server.env
ExecStart=/opt/review-lab/.venv/bin/python -m webui.worker
Restart=on-failure
RestartSec=15
UMask=0077
KillMode=control-group
TimeoutStopSec=30
[Install]
WantedBy=multi-user.target
