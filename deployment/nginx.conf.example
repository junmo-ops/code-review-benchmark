# Replace domain and TLS certificate paths before installation.
# Default workbench mode is direct access (BENCH_AUTH_MODE=none).
server {
    listen 443 ssl;
    server_name review-lab.example.internal;
    ssl_certificate /etc/review-lab/tls/fullchain.pem;
    ssl_certificate_key /etc/review-lab/tls/privkey.pem;
    client_max_body_size 16k;
    location / {
        proxy_pass http://127.0.0.1:8766;
        proxy_set_header Host $host;
        proxy_read_timeout 120s;
    }
}
