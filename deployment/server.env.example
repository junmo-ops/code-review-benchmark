BENCH_SERVER_MODE=1
BENCH_DATA_ROOT=/var/lib/review-lab
BENCH_CONFIG_ROOT=/etc/review-lab/models
BENCH_DOCKER_CONTEXT=default
BENCH_PUBLIC_URL=https://review-lab.example.internal
BENCH_AUTH_MODE=none
# Generate a CSRF token: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
BENCH_CSRF_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_VALUE
PYTHONUNBUFFERED=1
PATH=/opt/review-lab/bin:/opt/review-lab/.venv/bin:/usr/local/bin:/usr/bin:/bin
HOME=/var/lib/review-lab

# 多实例数据库：Web 和 Worker 配置相同账号密码；密码由部署平台 Secret 注入。
# 部署的 mode、MySQL 地址和 COS 连接参数在 deployment/cluster.json 中维护。
BENCH_DB_USER=REPLACE_WITH_DATABASE_USER
BENCH_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# 使用同一镜像部署多个环境时，为同一环境的所有 Web 和 Worker 设置相同 scope。
# BENCH_CLUSTER_SCOPE=st

# 可选的全局并发上限。所有 Web 实例使用同一个值。省略时沿用数据库上限，新环境默认 5。
# BENCH_GLOBAL_CONCURRENCY=5
