BENCH_SERVER_MODE=1
BENCH_DATA_ROOT=/var/lib/review-lab
BENCH_CONFIG_ROOT=/etc/review-lab/models
BENCH_DOCKER_CONTEXT=default
BENCH_PUBLIC_URL=https://review-lab.example.internal
# Generate two distinct values: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
BENCH_PROXY_TOKEN=REPLACE_WITH_RANDOM_VALUE
BENCH_CSRF_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_VALUE
PYTHONUNBUFFERED=1
PATH=/opt/review-lab/bin:/opt/review-lab/.venv/bin:/usr/local/bin:/usr/bin:/bin
HOME=/var/lib/review-lab
