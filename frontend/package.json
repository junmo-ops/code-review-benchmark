{
  "name": "code-review-benchmark-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src vite.config.ts eslint.config.js index.html",
    "typecheck": "tsc -b",
    "bundle": "vite build"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "antd": "^5.27.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "3.8.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.61.0",
    "vite": "7.2.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
