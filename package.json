{
  "name": "code-review-benchmark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/project.mjs setup",
    "dev": "node scripts/project.mjs dev",
    "start": "node scripts/project.mjs start",
    "backend": "node scripts/project.mjs backend",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "check": "node scripts/project.mjs check",
    "cli": "node scripts/project.mjs cli",
    "verify": "node scripts/project.mjs verify",
    "verify:dsh": "node scripts/dsh/verify.mjs",
    "package:changes": "node scripts/project.mjs package",
    "hooks:install": "git config core.hooksPath .githooks",
    "e2e": "node scripts/e2e/run.mjs",
    "e2e:setup": "npm install --prefix scripts/e2e && npm exec --prefix scripts/e2e -- playwright install chromium",
    "e2e:explore": "node scripts/e2e/run.mjs --explore",
    "e2e:container": "node scripts/e2e/run.mjs --container",
    "e2e:container:build": "node scripts/e2e/build-container.mjs"
  }
}
